{
  "name": "hardwarevs-app",
  "version": "1.0.0",
  "description": "HardwareVS — приложение для ПК и Android",
  "author": "HardwareVS",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.hardwarevs.desktop",
    "productName": "HardwareVS",
    "files": [
      "main.js",
      "offline.html",
      "build/icon.png"
    ],
    "icon": "build/icon.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "HardwareVS-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "HardwareVS-Portable-${version}.${ext}"
    }
  }
}